            "number": 91,
            "text": "    def process_one_flip(self) -> bool:"
          },
          {
            "number": 92,
            "text": "        \"\"\"Find unprocessed flip, send notifications."
          },
          {
            "number": 93,
            "text": ""
          },
          {
            "number": 94,
            "text": "        Return True if the main loop should continue right away."
          },
          {
            "number": 95,
            "text": ""
          },
          {
            "number": 96,
            "text": "        Return False if the main loop should  wait a bit before continuing."
          },
          {
            "number": 97,
            "text": "        (because either all workers are currently busy or there are currently no"
          },
          {
            "number": 98,
            "text": "        unprocessed flips in the database)."
          },
          {
            "number": 99,
            "text": ""
          },
          {
            "number": 100,
            "text": "        \"\"\""
          },
          {
            "number": 101,
            "text": ""
          },
          {
            "number": 102,
            "text": "        if not self.seats.acquire(timeout=1):"
          },
          {
            "number": 103,
            "text": "            return False  # Workers busy, main thread should wait a bit"
          },
          {
            "number": 104,
            "text": ""
          },
          {
            "number": 105,
            "text": "        flip = Flip.objects.filter(processed=None).first()"
          },
          {
            "number": 106,
            "text": "        if flip is None:"
          },
          {
            "number": 107,
            "text": "            self.seats.release()"
          },
          {
            "number": 108,
            "text": "            return False  # No work found, main thread should wait a bit"
          },
          {
            "number": 109,
            "text": ""
          },
          {
            "number": 110,
            "text": "        # Mark the flip as processed:"
          },
          {
            "number": 111,
            "text": "        q = Flip.objects.filter(id=flip.id, processed=None)"
          },
          {
            "number": 112,
            "text": "        num_updated = q.update(processed=now())"
          },
          {
            "number": 113,
            "text": "        if num_updated != 1:"
          },
          {
            "number": 114,
            "text": "            self.seats.release()"
          },
          {
            "number": 115,
            "text": "            # Nothing got updated: another sendalerts process got there first."
          },
          {
            "number": 116,
            "text": "            return True"
          },
          {
            "number": 117,
            "text": ""
          },
          {
            "number": 118,
            "text": "        statsd.incr(\"hc.sendalerts.processFlip\")"
          },
          {
            "number": 119,
            "text": "        f = self.executor.submit(notify, flip)"
          },
          {
            "number": 120,
            "text": "        f.add_done_callback(self.on_notify_done)"
          },
          {
            "number": 121,
            "text": "        return True"
          }
        ]
      }
