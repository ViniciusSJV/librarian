            "number": 24,
            "text": "def notify(flip: Flip) -> str | None:"
          },
          {
            "number": 25,
            "text": "    # This is run via ThreadPoolExecutor. The thread may already have an open"
          },
          {
            "number": 26,
            "text": "    # db connection. If notify has not run recently then the db connection may have"
          },
          {
            "number": 27,
            "text": "    # timed out. We call close_old_connections() to make sure we have a working db"
          },
          {
            "number": 28,
            "text": "    # connection. The if condition makes sure this does not run during tests."
          },
          {
            "number": 29,
            "text": "    if not connection.in_atomic_block:"
          },
          {
            "number": 30,
            "text": "        close_old_connections()"
          },
          {
            "number": 31,
            "text": ""
          },
          {
            "number": 32,
            "text": "    # Set or clear dates for followup nags"
          },
          {
            "number": 33,
            "text": "    check = flip.owner"
          },
          {
            "number": 34,
            "text": "    check.project.update_next_nag_dates()"
          },
          {
            "number": 35,
            "text": "    channels = flip.select_channels()"
          },
          {
            "number": 36,
            "text": "    if not channels:"
          },
          {
            "number": 37,
            "text": "        return None"
          },
          {
            "number": 38,
            "text": ""
          },
          {
            "number": 39,
            "text": "    send_start = now()"
          },
          {
            "number": 40,
            "text": "    logs = [f\"{check.code} goes {flip.new_status}\"]"
          },
          {
            "number": 41,
            "text": "    for ch in channels:"
          },
          {
            "number": 42,
            "text": "        notify_start = time.time()"
          },
          {
            "number": 43,
            "text": "        error = ch.notify(flip)"
          },
          {
            "number": 44,
            "text": "        secs = time.time() - notify_start"
          },
          {
            "number": 45,
            "text": "        code8 = str(ch.code)[:8]"
          },
          {
            "number": 46,
            "text": "        if error:"
          },
          {
            "number": 47,
            "text": "            logs.append(f\"  {code8} ({ch.kind}) Error in {secs:.1f}s: {error}\")"
          },
          {
            "number": 48,
            "text": "            statsd.incr(f\"hc.notifications.{ch.kind}.fail\")"
          },
          {
            "number": 49,
            "text": "        else:"
          },
          {
            "number": 50,
            "text": "            logs.append(f\"  {code8} ({ch.kind}) OK in {secs:.1f}s\")"
          },
          {
            "number": 51,
            "text": "            statsd.incr(f\"hc.notifications.{ch.kind}.success\")"
          },
          {
            "number": 52,
            "text": ""
          },
          {
            "number": 53,
            "text": "    statsd.timing(\"hc.sendalerts.dwellTime\", send_start - flip.created)"
          },
          {
            "number": 54,
            "text": "    statsd.timing(\"hc.sendalerts.sendTime\", now() - send_start)"
          },
          {
            "number": 55,
            "text": "    return \"\\n\".join(logs)"
          }
        ]
